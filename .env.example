# Skopiuj jako .env i ustaw wlasne sekrety. Plik .env jest ignorowany przez Git.
# Ustaw 1 na publicznym serwerze. Wtedy check_production.py wymaga konfiguracji HTTPS.
NUPICAI_PRODUCTION=0
NUPIC_API_KEY=

# Konta i pliki użytkowników.
NUPICAI_SESSION_DAYS=30
NUPICAI_DATA_RETENTION_HOURS=24
# Startowy limit nowego konta w sekundach gotowego audio (300 = 5 minut).
NUPICAI_FREE_SECONDS=300
# Konta administratorów z nielimitowanym renderingiem (lista po przecinku).
NUPICAI_ADMIN_EMAILS=admin@example.com
# Ustaw 1 za reverse proxy z HTTPS. Dla localhost pozostaw 0.
NUPICAI_SECURE_COOKIES=0
NUPICAI_MAX_UPLOAD_MB=1024
NUPICAI_MAX_VOICE_PROMPT_MB=100
# Opcjonalna allowlista naglowka Host, np. nupicai.pl,www.nupicai.pl.
NUPICAI_ALLOWED_HOSTS=
# Publiczny adres strony używany w canonical i podglądach społecznościowych.
NEXT_PUBLIC_SITE_URL=http://localhost:8765
# Publiczny adres używany w jednorazowych linkach resetu hasła.
NUPICAI_PUBLIC_URL=http://localhost:8765
NUPICAI_PASSWORD_RESET_TTL_SECONDS=3600
# Poczta transakcyjna Resend. Nadawca musi należeć do zweryfikowanej domeny.
RESEND_API_KEY=
NUPICAI_EMAIL_FROM=NupicAI <noreply@example.com>

HOST=0.0.0.0
PORT=8765
WEGORZ_CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Opcjonalne nadpisania.
TRANSLATION_ENDPOINT=https://ai.nupic.homes/v1
TRANSLATION_MODEL=qwen3.5:35b-mtp
TRANSLATION_MODE=qwen_mtp_35b_json_overlap
TRANSLATION_BATCH_SEGMENTS=8
# WEGORZ_YTDLP_COOKIES_FROM_BROWSER=firefox
# WEGORZ_YTDLP_COOKIES_FILE=/sciezka/cookies.txt
# Opcjonalne ustawienia oficjalnego ekstraktora, np. dostawcy PO Token.
# WEGORZ_YTDLP_EXTRACTOR_ARGS=youtube:player_client=mweb
