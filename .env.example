# Skopiuj jako .env i ustaw wlasne sekrety. Plik .env jest ignorowany przez Git.
WEGORZ_ADMIN_TOKEN=zmien-ten-token
NUPIC_API_KEY=

# Konta i pliki użytkowników.
NUPICAI_SESSION_DAYS=30
NUPICAI_DATA_RETENTION_HOURS=24
# Ustaw 1 za reverse proxy z HTTPS. Dla localhost pozostaw 0.
NUPICAI_SECURE_COOKIES=0
# Publiczny adres strony używany w canonical i podglądach społecznościowych.
NEXT_PUBLIC_SITE_URL=http://localhost:8765

HOST=0.0.0.0
PORT=8765
WEGORZ_CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Opcjonalne nadpisania.
TRANSLATION_ENDPOINT=https://ai.nupic.homes/v1
TRANSLATION_MODEL=qwen3.5:35b-mtp
TRANSLATION_MODE=qwen_mtp_35b_json_overlap
TRANSLATION_BATCH_SEGMENTS=8
# WEGORZ_YTDLP_COOKIES_FROM_BROWSER=firefox
# WEGORZ_YTDLP_COOKIES_FILE=/sciezka/cookies.txt
