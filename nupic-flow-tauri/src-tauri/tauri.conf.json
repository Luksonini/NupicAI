{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NupicAI Flow",
  "version": "0.1.0",
  "identifier": "ai.nupic.flow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NupicAI Flow",
        "width": 390,
        "height": 560,
        "minWidth": 350,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hold a shortcut, speak, and paste the transcript.",
    "longDescription": "NupicAI Flow is a lightweight push-to-talk dictation client for NupicAI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
